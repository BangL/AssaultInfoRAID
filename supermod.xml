<?xml version="1.0"?>
<mod name="AssaultInfoRAID" image="icon.png"
	description="Shows assault phase, time left, enemy count and kill pool in a configurable info box (reduced as client)"
	author="BangL"
	version="0.1.3"
	min_sblt_version="2.0.0"
	color="60 60 60">

	<updates>
		<update identifier="assaultinforaid">
			<host meta="https://raw.githubusercontent.com/BangL/raid-mods-meta/main/assaultinforaid.json" patchnotes="https://github.com/BangL/AssaultInfoRAID/blob/master/CHANGELOG.md"/>
		</update>
	</updates>

	<localization directory="Loc">
		<loc file="english.json" language="english"/>
		<loc file="german.json" language="german"/>
	</localization>

	<hooks>
		<pre hook_id="lib/entry" script_path="AssaultInfoRAID.lua"/>
		<post hook_id="lib/managers/hudmanagerpd2" script_path="Lua/HUDManagerPD2.lua"/>
		<post hook_id="lib/network/base/basenetworksession" script_path="Lua/Sync.lua"/>
		<post hook_id="lib/managers/menu/menucomponentmanager" script_path="Lua/MenuComponentManager.lua"/>
	</hooks>
</mod>
